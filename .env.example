# Secret configured on the GitHub webhook (repo Settings > Webhooks > Secret).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GITHUB_WEBHOOK_SECRET=

# Discord incoming webhook URL (Server Settings > Integrations > Webhooks).
# Looks like: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# Port the server listens on. Most hosts (Render, Railway, Fly) set this
# automatically in production, so you usually don't need it there.
PORT=3000
